# Copy to .env and fill in. Generate each secret with:  openssl rand -hex 32
#
# Management password for the panel (used once, on first start; it is stored hashed).
INITIAL_PASSWORD=change-me-to-a-long-passphrase
# Signs panel sessions. Changing it signs everyone out.
JWT_SECRET=
# Used to derive API keys. Do not change it once keys exist.
API_KEY_SECRET=
# Encrypts stored provider credentials (64 hex characters). Losing it makes saved accounts unreadable: back it up.
STORAGE_ENCRYPTION_KEY=
