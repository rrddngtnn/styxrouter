{
  "name": "@styxrouter/server",
  "version": "0.3.0",
  "description": "StyxRouter server — Hono+Bun host with executors, OAuth, DB.",
  "type": "module",
  "bin": {
    "styxrouter": "./bin/styxrouter.ts"
  },
  "files": [
    "bin/",
    "server/",
    "open-sse/",
    "panel/",
    "tsconfig.json",
    "src/app/api/",
    "src/domain/",
    "src/lib/",
    "src/models/",
    "src/server/",
    "src/shared/",
    "src/sse/",
    "src/types/",
    ".env.example",
    "README.md",
    "LICENSE",
    "licenses/",
    "!**/node_modules/**",
    "!**/__tests__/**",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.test.js",
    "!**/*.test.mjs",
    "!**/*.spec.ts",
    "!**/*.spec.tsx"
  ],
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.22.2 <23 || >=24.0.0 <27"
  },
  "keywords": [
    "ai",
    "router",
    "proxy",
    "openai",
    "claude",
    "anthropic",
    "gemini",
    "fallback",
    "cursor",
    "cline",
    "codex",
    "llm",
    "auto-fallback"
  ],
  "license": "SEE LICENSE IN licenses/README.md",
  "scripts": {
    "start": "bun server/styx.ts",
    "test": "bun scripts/test-isolated.ts",
    "typecheck": "bun --bun tsc --noEmit",
    "test:py": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "prepack": "cd ../panel && bun run build && cd ../server && rm -rf panel && cp -r ../panel/dist panel",
    "postpack": "rm -rf panel && ln -s ../panel/dist panel"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1112.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@toon-format/toon": "^4.1.1",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "bottleneck": "^2.19.5",
    "fetch-socks": "^1.3.3",
    "fflate": "^0.8.3",
    "hono": "^4.13.0",
    "ioredis": "^5.10.1",
    "ipaddr.js": "^2.2.0",
    "jose": "^6.2.9",
    "js-tiktoken": "^1.0.21",
    "node-machine-id": "^1.1.12",
    "omniglyph": "^1.4.0",
    "open": "^11.0.1",
    "parse5": "^8.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "1.62.1",
    "playwright-core": "1.62.1",
    "safe-regex": "^2.1.1",
    "sharp": "^0.35.3",
    "smol-toml": "1.8.0",
    "socks": "^2.8.7",
    "sql.js": "^1.14.2",
    "tsx": "^4.23.12",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "undici": "^8.10.0",
    "uuid": "^14.0.0",
    "ws": "^8.21.3",
    "xxhash-wasm": "^1.1.0",
    "yazl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "26.6.6",
    "typescript": "^5.7.2"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.1",
    "tls-client-node": "^0.2.0",
    "wreq-js": "^3.0.0"
  }
}
